#refatoração do CRUD:
filmes = []
opcao = -1

while opcao != 0:
    print("\n===== CRUD NETFLIX =====")
    print("1 - Cadastrar filme")
    print("2 - Listar filmes")
    print("3 - Atualizar filme")
    print("4 - Excluir filme")
    print("0 - Sair")

    opcao = int(input("Digite o número da opção: "))

    if opcao == 1:
        nome = input("Digite o nome do filme: ")
        duracao = int(input("Digite a duração em minutos: "))
        genero = input("Digite o gênero do filme: ")
        sinopse = input("Digite a sinopse: ")
        ano = int(input("Qual o ano de lançamento? "))
        nota = float(input("Qual é a nota? "))

        cadastrado = True
        print("Filme cadastrado com sucesso!")

        filme = {
        "nome": nome,
        "duracao": duracao,
        "genero": genero,
        "sinopse": sinopse,
        "ano": ano,
        "nota": nota
        }

        filmes.append(filme)

    elif opcao == 2:
        quantidade = len(filmes)
        if quantidade == 0:
            print("Nenhum dado encontrado.")
        else:
            print("===== FILMES CADASTRADOS =====")
            for filme in filmes:
                print("-------------------------")
                print("nome: ", filme["nome"])
                print('duração: ', filme["duracao"])
                print('gênero: ', filme["genero"])
                print('sinopse: ', filme["sinopse"])
                print('ano: ', filme["ano"])
                print('nota: ', filme["nota"])
                



   
    elif opcao == 3:
        if len(filmes) != 0:
            print("\n===== SELECIONE O FILME =====")

            for i in range(len(filmes)):
                print(i + 1, "-", filmes[i]["nome"])

            indice = int(input("Digite o número do filme que deseja atualizar: "))

            if indice >= 1 and indice <= len(filmes):
                filme = filmes[indice - 1]

                subopcao = -1

                while subopcao != 0:
                    print("\n===== ATUALIZAR FILME =====")
                    print("1 - Nome:", filme["nome"])
                    print("2 - Duração:", filme["duracao"])
                    print("3 - Gênero:", filme["genero"])
                    print("4 - Sinopse:", filme["sinopse"])
                    print("5 - Ano:", filme["ano"])
                    print("6 - Nota:", filme["nota"])
                    print("0 - Voltar ao menu principal")

                    subopcao = int(input("Qual campo deseja atualizar? "))

                    if subopcao == 1:
                        filme["nome"] = input("Digite o novo nome: ")
                        print("Nome atualizado!")

                    elif subopcao == 2:
                        filme["duracao"] = int(input("Digite a nova duração em minutos: "))
                        print("Duração atualizada!")

                    elif subopcao == 3:
                        filme["genero"] = input("Digite o novo gênero: ")
                        print("Gênero atualizado!")

                    elif subopcao == 4:
                        filme["sinopse"] = input("Digite a nova sinopse: ")
                        print("Sinopse atualizada!")

                    elif subopcao == 5:
                        filme["ano"] = int(input("Digite o novo ano: "))
                        print("Ano atualizado!")

                    elif subopcao == 6:
                        filme["nota"] = float(input("Digite a nova nota: "))
                        print("Nota atualizada!")

                    elif subopcao == 0:
                        print("Voltando ao menu principal...")

                    else:
                        print("Opção inválida!")

            else:
                print("Filme não encontrado!")

        else:
            print("Nenhum filme cadastrado!")


    
    elif opcao == 4:
        if len(filmes) != 0:
            print("\n===== SELECIONE O FILME =====")

            for i in range(len(filmes)):
                print(i + 1, "-", filmes[i]["nome"])

            indice = int(input("Digite o número do filme que deseja excluir: "))

            if indice >= 1 and indice <= len(filmes):
                filme = filmes[indice - 1]

                print("\n===== EXCLUIR FILME =====")
                print("Filme:", filme["nome"])

                confirmacao = input("Deseja excluir este filme? (s/n): ")

                if confirmacao == "s":
                    filmes.pop(indice - 1)
                    print("Filme excluído com sucesso!")

                else:
                    print("Exclusão cancelada!")

            else:
                print("Filme não encontrado!")

        else:
            print("Nenhum filme cadastrado!")
